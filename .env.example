# Pinata IPFS Credentials
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here
PINATA_JWT=your_pinata_jwt_token_here

# Polygon Testnet RPC URL (Polygon Amoy is active testnet; Mumbai is deprecated)
# For Polygon Amoy Testnet: https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ALCHEMY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# MetaMask Private Key (NEVER commit real private key to version control)
PRIVATE_KEY=your_metamask_private_key_here

# Polygonscan API Key for Contract Verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here